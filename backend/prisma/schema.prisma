generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
}

enum RequestStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PoolStatus {
  MATCHING
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  role          Role
  vehicles      Vehicle[]
  rideRequests  RideRequest[]
  ridePools     RidePool[]
  createdAt     DateTime      @default(now())
}

model Vehicle {
  id        String     @id @default(uuid())
  driverId  String
  name      String
  capacity  Int
  driver    User       @relation(fields: [driverId], references: [id])
  ridePools RidePool[]
  createdAt DateTime   @default(now())
}

model RidePool {
  id        String        @id @default(uuid())
  driverId  String
  vehicleId String
  status    PoolStatus    @default(MATCHING)
  driver    User          @relation(fields: [driverId], references: [id])
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  requests  RideRequest[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model RideRequest {
  id                   String        @id @default(uuid())
  passengerId          String
  poolId               String?
  pickupLocation       String
  dropoffLocation      String
  seatsRequested       Int
  status               RequestStatus @default(REQUESTED)
  baseFarePoysha       Int
  distanceChargePoysha Int
  poolDiscountPoysha   Int
  finalFarePoysha      Int
  passenger            User          @relation(fields: [passengerId], references: [id])
  pool                 RidePool?     @relation(fields: [poolId], references: [id])
  createdAt            DateTime      @default(now())
}