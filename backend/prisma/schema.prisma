generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
}

enum PoolStatus {
  MATCHING
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  role         Role          @default(PASSENGER)
  isOnline     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vehicles     Vehicle[]
  ridePools    RidePool[]    @relation("DriverPools")
  rideRequests RideRequest[]

  @@map("users")
}

model Vehicle {
  id        String     @id @default(uuid())
  driverId  String     @unique
  name      String     // "Bullet"
  capacity  Int        @default(3)
  createdAt DateTime   @default(now())

  driver    User       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  ridePools RidePool[]

  @@map("vehicles")
}

model RidePool {
  id          String        @id @default(uuid())
  driverId    String
  vehicleId   String
  status      PoolStatus    @default(MATCHING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  driver      User          @relation("DriverPools", fields: [driverId], references: [id])
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  requests    RideRequest[]

  @@map("ride_pools")
}

model RideRequest {
  id                   String        @id @default(uuid())
  passengerId          String
  poolId               String?
  pickupLocation       String        // e.g., "Banani"
  dropoffLocation      String        // e.g., "Mohakhali"
  seatsRequested       Int           @default(1)
  status               RequestStatus @default(REQUESTED)
  
  // Stored in poysha (integer) to avoid float rounding errors
  baseFarePoysha       Int           @default(0)
  distanceChargePoysha Int           @default(0)
  poolDiscountPoysha   Int           @default(0)
  finalFarePoysha      Int           @default(0)
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  passenger            User          @relation(fields: [passengerId], references: [id])
  pool                 RidePool?     @relation(fields: [poolId], references: [id], onDelete: SetNull)

  @@map("ride_requests")
}